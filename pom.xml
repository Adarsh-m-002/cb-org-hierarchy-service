<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.0</version>
		<relativePath/>
	</parent>
	<groupId>com.HierarchyHub</groupId>
	<artifactId>cb-org-hierarchy-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>cb-org-hierarchy-service</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- legacy /org/v1/hierarchy (Neo4j OGM) - left as-is per explicit instruction; pinned to its original
		     versions since Spring Boot 3's own BOM no longer manages this old, OGM-based Spring Data Neo4j API -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-neo4j</artifactId>
			<version>2.0.0.RELEASE</version>
		</dependency>

		<!-- the starter above transitively wants this, but the parent BOM's own dependencyManagement would
		     otherwise force it to Spring Boot 3's much newer (non-OGM) spring-data-neo4j - pinned explicitly so
		     the legacy v1 Neo4j code (SessionFactory, @NodeEntity, Neo4jTransactionManager) keeps compiling as-is -->
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-neo4j</artifactId>
			<version>5.0.5.RELEASE</version>
		</dependency>

		<!-- same reason: spring-data-neo4j 5.0.5 was built against this generation of spring-data-commons, not
		     Spring Boot 3's much newer managed one (whose CrudRepository signatures don't line up with it) -->
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-commons</artifactId>
			<version>2.0.7.RELEASE</version>
		</dependency>

		<dependency>
			<groupId>org.neo4j</groupId>
			<artifactId>neo4j-ogm-bolt-driver</artifactId>
			<version>3.1.7</version>
		</dependency>

		<!-- neo4j-ogm-bolt-driver:3.1.7 needs the old org.neo4j.driver.v1.* package (driver 1.x) - the parent BOM
		     would otherwise force this up to a 4.x+/5.x driver, which dropped that package (NoClassDefFoundError:
		     org/neo4j/driver/v1/exceptions/ClientException at runtime, confirmed against a live Neo4j) -->
		<dependency>
			<groupId>org.neo4j.driver</groupId>
			<artifactId>neo4j-java-driver</artifactId>
			<version>1.7.5</version>
		</dependency>

		<dependency>
			<groupId>org.neo4j</groupId>
			<artifactId>neo4j-ogm-core</artifactId>
			<version>3.1.7</version>
		</dependency>

		<dependency>
			<groupId>org.neo4j</groupId>
			<artifactId>neo4j-ogm-api</artifactId>
			<version>3.1.7</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- org-hierarchy v2 module (com.hierarchyhub.orghierarchy): PostgreSQL-backed link/move/unlink -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.5.4</version>
		</dependency>

		<!-- Bulk /bulk/link file upload: reads the uploaded .xlsx sheet, in memory, row by row -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.5</version>
		</dependency>

		<!-- Bulk /bulk/link original-file and result-file storage: same cloud storage SDK/version sunbird-cb-ext
		     already uses, so both services read/write the same bucket - see bulk-hierarchy-upload-download-implementation-plan.md -->
		<dependency>
			<groupId>net.karmayogibharat</groupId>
			<artifactId>cloud-store-sdk</artifactId>
			<version>1.4.6.2</version>
			<exclusions>
				<!-- hadoop-common pulls slf4j-reload4j, which fights Spring Boot's own Logback binding at startup -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-reload4j</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- javax.xml.bind was removed from the JDK itself in Java 11+; cloud-store-sdk's Azure/jclouds path
		     still needs it at runtime on Java 17 (NoClassDefFoundError: javax/xml/bind/JAXBException otherwise) -->
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.1</version>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>2.3.1</version>
			<scope>runtime</scope>
		</dependency>

		<!-- cloud-store-sdk pulls com.typesafe:config 1.3.0, too old for Spring Boot 3.2's own Cassandra
		     autoconfiguration (needs ConfigFactory.defaultReferenceUnresolved(), added in 1.4.2) - force the newer one -->
		<dependency>
			<groupId>com.typesafe</groupId>
			<artifactId>config</artifactId>
			<version>1.4.2</version>
		</dependency>

		<!-- cloud-store-sdk's hadoop-azure pulls httpclient 4.2.5 (2013, predates RequestConfig entirely), which
		     wins dependency mediation over elasticsearch-rest-client's own newer httpclient - force the newer one -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>4.5.14</version>
		</dependency>

		<!-- Cassandra (organisation master lookup) and access-token verification: the same shared library
		     cb-search-service uses, instead of this service's own hand-rolled versions of either -->
		<dependency>
			<groupId>net.karmayogibharat</groupId>
			<artifactId>common-util</artifactId>
			<version>1.0.5</version>
		</dependency>

		<!-- /bulk/link master-data: scrolling the org_alias/org_v4 index directly (sunbird-lms-service's own
		     genuinely-6.8.2 ES cluster, confirmed from its own mapping dump) instead of its org/v1/search API,
		     which can't paginate past ES's 10,000-hit result-window ceiling. The LOW-LEVEL REST client, not
		     co.elastic.clients' typed API (cb-ext-course-service's own choice, but that client always sends the
		     ES 7.14+/8.x "compatible-with" media type, which a true 6.8 server flatly rejects with HTTP 406) -
		     the low-level client is plain JSON-over-HTTP with no version coupling, same version sunbird-lms-service
		     itself already runs against this exact cluster. -->
		<dependency>
			<groupId>org.elasticsearch.client</groupId>
			<artifactId>elasticsearch-rest-client</artifactId>
			<version>6.8.22</version>
		</dependency>

		<!-- Java 17: generate getters/setters/constructors instead of hand-writing them on plain bean-style DTOs -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Hierarchy mutation event streaming (/link, /bulk/link, /move, /unlink -> org-hierarchy-edges topic) -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- The default RestTemplate request factory (JDK HttpURLConnection) refuses PATCH ("Invalid HTTP method: PATCH")
		     - needed for the shared RestTemplate bean to call the external Sunbird org-update API. -->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- cloud-store-sdk's jclouds path (Guice 3.0's own CGLIB at startup, reflective java.net.URI
					     construction on every upload/download) needs these opens on Java 17 - an IDE run
					     configuration needs the same VM options added manually -->
					<jvmArguments>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.net=ALL-UNNAMED</jvmArguments>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
